  /* ---- Línea de tiempo del reto (#la-semana) ----
     Los estados (pendiente / activo / hecho) los pone el script con
     data-estado, pero SOLO bajo html.reto-vivo: sin JavaScript todo se ve
     completo y encendido. El apagado va por color y fondo, nunca por opacity
     (Lighthouse compone la opacidad y el contraste se hunde). El movimiento se
     apaga con prefers-reduced-motion; los estados siguen, porque son color. */
  /* La franja se queda fija bajo la cabecera mientras dura la línea de tiempo
     (su contenedor es la sección, así que se suelta al terminar). El fondo
     sale a todo el ancho con un recorte, y la cabecera mide --alto-cab (lo
     pone el script) para que no se encimen. */
  .etapas {
    --avance: 1;
    position: sticky;
    top: var(--alto-cab, 4.5rem);
    z-index: 4;
    margin: 0 0 2rem;
    padding: 0.9rem 0 0.8rem;
  }
  .etapas::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-bg);
    box-shadow: 0 0 0 100vmax var(--color-bg);
    clip-path: inset(0 -100vmax);
    border-bottom: 1px solid var(--color-line);
  }
  .etapas-barra {
    position: relative;
    margin-bottom: 0.7rem;
    height: 3px;
    background: var(--color-line);
    border-radius: 2px;
    overflow: hidden;
  }
  .etapas-relleno {
    display: block;
    height: 100%;
    background: var(--color-accent);
    transform-origin: left;
    transform: scaleX(var(--avance));
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  html.reto-vivo .etapas {
    --avance: 0;
  }
  .etapas ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.6rem;
  }
  .etapas a {
    display: block;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-ink-soft);
    background: transparent;
    transition:
      background 0.4s ease,
      color 0.4s ease,
      border-color 0.4s ease,
      transform 0.4s ease;
  }
  .etapa-num {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
