  /* El tramo de línea que baja de este nodo al siguiente. Se llena cuando el
     día queda atrás: es el avance de lo que ya sabes hacer. */
  .dia::before {
    content: "";
    position: absolute;
    left: 0.78rem;
    top: 1.7rem;
    bottom: -0.3rem;
    width: 2px;
    background: var(--color-line-strong);
  }
  .dia::after {
    content: "";
    position: absolute;
    left: 0.78rem;
    top: 1.7rem;
    bottom: -0.3rem;
    width: 2px;
    background: var(--color-accent);
    transform-origin: top;
    transform: scaleY(1);
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .dia:last-child::before,
  .dia:last-child::after {
    display: none;
