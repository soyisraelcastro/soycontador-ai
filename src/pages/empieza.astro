    margin-top: 0.1rem;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }
  html.reto-vivo .etapas [data-estado="hecho"] a {
    border-color: var(--color-accent);
    color: var(--color-ink);
  }
  html.reto-vivo .etapas [data-estado="activo"] a {
    border-color: var(--color-accent);
    background: var(--color-surface-raised);
    color: var(--color-ink);
    transform: translateY(-3px);
  }
  /* En pantallas angostas la franja ocupa poco: cinco casillas con el número,
     y solo la activa dice su nombre. */
  @media (max-width: 760px) {
    .etapas ol {
      gap: 0.35rem;
    }
    .etapas a {
      padding: 0.4rem 0.2rem;
