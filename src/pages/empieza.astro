---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqBlock from "../components/FaqBlock.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import Hojas from "../components/Hojas.astro";
import VideoFacade from "../components/VideoFacade.astro";
import { COLABORACION } from "../lib/capacitacion";
import {
  ALCANCE,
  DIAS,
  EMPIEZA,
  FAQ_EMPIEZA,
  HORARIO,
  INCLUYE,
  PARA_QUIEN,
  VIDEO_EMPIEZA,
  checkoutDe,
  edicionAbierta,
  edicionesVigentes,
} from "../lib/empieza";
import { breadcrumbs, empiezaCourse, faqPage, graph } from "../lib/schema";
import { SITE, type Enlace } from "../lib/site";
import { TESTIMONIOS } from "../lib/testimonios";

const jsonLd = graph(
  empiezaCourse(),
  faqPage(FAQ_EMPIEZA, `${SITE.url}/empieza`),
  breadcrumbs([
    { name: "Inicio", path: "/" },
    { name: "Capacitación", path: "/capacitacion" },
    { name: EMPIEZA.nombreCompleto, path: "/empieza" },
  ]),
);

/* Una edición hoy (el reto de diciembre). Si el evento de nas.com todavía no
   existe, `checkout` es null: la página no muestra botón de compra y dice que
   el registro abre en unos días. Si se llena, `agotado` lo apaga. */
const ediciones = edicionesVigentes();
const abierta = edicionAbierta();
const urlAbierta = abierta ? checkoutDe(abierta) : null;
const hayPorAbrir = ediciones.some((e) => !e.agotado && !e.checkout);
/* Sin checkout abierto, el botón nunca queda muerto: o avisa cuándo abre
   (evento por crear en nas.com) o avisa de la siguiente edición (se llenó o ya
   pasó la fecha). Con checkout, manda a comprar y el cuadro no se monta. */
const modoAviso = !urlAbierta;
const textoBoton = hayPorAbrir ? "El registro abre en unos días" : "Avísame de la siguiente edición";
const tituloAviso = hayPorAbrir ? "Avísame cuándo abre el registro" : "Avísame de la siguiente edición";
const fechaFolio = abierta?.fechaTexto ?? ediciones[0]?.fechaTexto ?? "Próxima fecha por anunciar";
/* Daniel es la prueba de esta página: su "analfabetos en programación" es
   exactamente el miedo de quien la lee. */
const daniel = TESTIMONIOS.find((t) => t.slug === "daniel-souza");

const NAV: readonly Enlace[] = [
  { label: "Para quién", href: "#para-quien" },
  { label: "Día por día", href: "#la-semana" },
  { label: "Lo que necesitas", href: "#necesitas" },
  { label: "Preguntas", href: "#faq" },
];
/* El botón de cabecera sigue al hero: con lugares manda al checkout; sin
   ellos, a la ficha, que es donde se explica qué sigue. */
const CTA: Enlace = urlAbierta
  ? { label: "Apartar mi lugar", href: urlAbierta }
  : { label: "Avísame cuándo", href: "#apartar" };
---

<BaseLayout
  title={`${EMPIEZA.nombreCompleto}. Cinco días, una hora diaria`}
  description={`Reto en vivo de 5 días, de lunes a viernes, ${fechaFolio.toLowerCase()}: pasas de probar la IA a trabajar con ella. Cada día termina con algo hecho en tu pantalla. Sin conocimientos previos. ${EMPIEZA.precioTexto}.`}
  jsonLd={jsonLd}
  nav={NAV}
  cta={CTA}
>
  {/*
    Los mundos de la home (Hojas.astro, 2026-10-01): día, noche, día, noche,
    día. `data-pausa` es el ritmo de lectura: una hoja alta se queda fija 30%
    de la ventana con su final a la vista antes de que la siguiente la tape.
    Desde el 2026-11-03 la página vende el reto de 5 días; la línea de tiempo
    (#la-semana) reemplaza a "las dos horas" del taller.
  */}
  <main data-pausa="0.3">
    <div class="mundo" data-mundo="dia">
      <section class="hero">
        <div class="container-default hero-grid">
          <div>
            <p class="folio">RETO EN VIVO · <b>{fechaFolio.toUpperCase()}</b> · {HORARIO.inicio} · 5 DÍAS</p>
            <h1 class="titulo-xl">{EMPIEZA.nombre}: <span class="hl">{EMPIEZA.titulo}</span></h1>
            <p class="hero-headline">Cada día termina con algo hecho en tu pantalla.</p>
            {/*
              Sin mencionar el curso grande (Israel, 2026-10-13): quien llega
              sin contexto o prefiere "el otro" y no aprovecha este, o no sabe
              de qué le hablamos. La escalera se sube DESPUÉS.
            */}
            <p class="hero-gancho">
              ¿La usas como buscador y cada respuesta sale distinta?{" "}
              <span class="tenue">En cinco días, una hora diaria, la conviertes en flujos de trabajo que repites tú, con el fundamento a la vista.</span>
            </p>
            <div class="hero-precio">
              <p class="precio">
                <b>{EMPIEZA.precioTexto}</b>
                <span>pago único · {EMPIEZA.duracion} · cupo de {EMPIEZA.cupo}</span>
              </p>
              <div class="hero-acciones">
                {urlAbierta ? (
                  <a class="btn btn-primary" href={urlAbierta} rel="noopener">Apartar mi lugar</a>
                ) : (
                  <div class="aviso-boton">
                    <button type="button" class="btn btn-primary" data-aviso>{textoBoton}</button>
                    <button type="button" class="aviso-nota" data-aviso>Clic aquí para apartar tu lugar</button>
                  </div>
                )}
                <a class="btn btn-ghost" href="#la-semana">Ver los cinco días</a>
              </div>
              {ediciones.length > 1 && (
                <ul class="fechas" aria-label="Fechas">
                  {ediciones.map((e) => (
                    <li class:list={{ agotada: e.agotado }}>
                      {e.fechaTexto}
                      <span class="folio">{e.agotado ? "AGOTADO" : "QUEDAN LUGARES"}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
          {/* El video va solo: el detalle de los cinco días ya vive en la línea
              de tiempo de más abajo. Si no hay video (VIDEO_EMPIEZA.id null),
              en su lugar va la lista corta de lo que te llevas. */}
          {VIDEO_EMPIEZA.id ? (
            <div class="hero-video">
              <VideoFacade
                videoId={VIDEO_EMPIEZA.id}
                titulo={VIDEO_EMPIEZA.titulo}
                poster={VIDEO_EMPIEZA.poster}
                cinta={VIDEO_EMPIEZA.cinta}
              />
            </div>
          ) : (
            <aside class="entregables" aria-labelledby="entregables-titulo">
              <p class="folio" id="entregables-titulo">CON QUÉ <b>SALES</b></p>
              <ol>
                {DIAS.map((d, i) => (
                  <li>
                    <span class="entregable-num">{String(i + 1).padStart(2, "0")}</span>
                    <span>
                      <b>{d.sale}</b>
                      <span class="entregable-texto">{d.dia} {d.fecha}</span>
                    </span>
                  </li>
                ))}
              </ol>
            </aside>
          )}
        </div>
      </section>

      <section id="para-quien">
        <div class="container-default">
          <div class="sec-head"><h2 class="folio">PARA <b>QUIÉN</b> ES</h2></div>
          <div class="perfiles">
            {PARA_QUIEN.map((p, i) => (
              <article class="perfil" data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
                <h3>{p.titulo}</h3>
                <p>{p.texto}</p>
              </article>
            ))}
          </div>
          <p class="no-es" data-reveal>
            Y para quién no: si buscas construir una plataforma completa, con
            servidor y base de datos, este reto se te queda corto.{" "}
            <a href="#faq">Aquí te digo por dónde seguir.</a>
          </p>
        </div>
      </section>
    </div>

    <div class="mundo" data-mundo="noche">
      <section id="la-semana">
        <div class="container-default">
          <div class="sec-head"><h2 class="folio">LA SEMANA, <b>DÍA POR DÍA</b></h2></div>
          <p class="intro-bloques" data-reveal>
            Cada día se apoya en el anterior: pides bien, das trabajo, lo
            vuelves repetible, lo fundamentas y lo empaquetas. Una hora diaria,
            de {HORARIO.inicio} a {HORARIO.fin}, hora del centro. Los datos son
            ficticios y te los llevas.
          </p>

          {/* El avance: cinco etapas que se van encendiendo conforme bajas.
              Es navegación (cada una lleva a su día) y, con JavaScript, el
              indicador de dónde vas. Sin JS es solo el índice. */}
          <nav class="etapas" aria-label="Las cinco etapas del reto">
            <div class="etapas-barra" aria-hidden="true"><span class="etapas-relleno"></span></div>
            <ol>
              {DIAS.map((d, i) => (
                <li data-etapa>
                  <a href={`#dia-${i + 1}`}>
                    <span class="etapa-num">{String(i + 1).padStart(2, "0")}</span>
                    <span class="etapa-nombre">{d.etapa}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>

          <ol class="linea">
            {DIAS.map((d, i) => (
              <li class="dia" id={`dia-${i + 1}`} data-dia>
                <span class="dia-nodo" aria-hidden="true"></span>
                <article class="dia-card">
                  <p class="folio">{d.dia.toUpperCase()} · <b>{d.fecha.toUpperCase()}</b> · {HORARIO.inicio} A {HORARIO.fin}</p>
                  <h3>{d.titulo}</h3>
                  <p class="dia-texto">{d.texto}</p>
                  <div class="salto">
                    <p><span class="folio">ANTES</span>{d.antes}</p>
                    <p class="salto-despues"><span class="folio">DESPUÉS</span>{d.despues}</p>
                  </div>
                  <p class="bloque-sale"><span class="folio">SALES CON</span> {d.sale}</p>
                </article>
              </li>
            ))}
          </ol>

          <div class="alcance" data-reveal>
            <p><span class="folio">SÍ HACEMOS</span>{ALCANCE.si}</p>
            <p><span class="folio">NO HACEMOS</span>{ALCANCE.no}</p>
          </div>
        </div>
      </section>

      <section id="necesitas">
        <div class="container-narrow">
          <div class="sec-head"><h2 class="folio">LO QUE <b>NECESITAS</b></h2></div>
          <div class="necesitas" data-reveal>
            {/*
              En el RETO Claude Pro es NECESARIO (decisión de Israel,
              2026-11-03; en el taller de 2 horas era solo recomendado): los
              scripts y las skills consumen muchos más tokens y no se quiere
              que nadie se quede limitado a media clase. El porqué y la salida
              (se cancela antes de que se renueve) están aquí y en la FAQ. El
              precio va en dólares, como lo muestra Claude, con el aproximado
              en pesos.
            */}
            <p>
              <b>Una suscripción a {EMPIEZA.herramienta.nombre}.</b>{" "}
              Cuesta {EMPIEZA.herramienta.costoTexto}. Lo que vemos en el reto
              (scripts, skills, lotes de XML) consume bastantes más tokens que
              un chat normal, y con el plan gratuito te quedarías limitado a
              media clase. Se paga aparte; si después del reto no te sirve, la
              cancelas antes de que se renueve.
              <span class="nota-fecha">Precio en claude.com/pricing, verificado el {EMPIEZA.herramienta.verificado}.</span>
            </p>
            <p><b>Computadora, no celular.</b> Se trabaja en vivo, con archivos.</p>
            <p><b>Una hora diaria, a las {HORARIO.inicio}.</b> De lunes a viernes. Si falta un día tienes la grabación.</p>
            <p><b>Nada más.</b> Ni programación, ni IA, ni haber leído nada. Cero.</p>
          </div>
        </div>
      </section>
    </div>

    <div class="mundo" data-mundo="dia">
      {daniel && (
        <section>
          <div class="container-narrow">
            <div class="sec-head"><h2 class="folio">ALGUIEN QUE <b>YA EMPEZÓ</b></h2></div>
            <figure class="prueba" data-reveal>
              <blockquote>"{daniel.antes}"</blockquote>
              <p class="prueba-texto">
                {daniel.nombre} lleva solo su despacho en {daniel.ciudad}. Hoy
                encuentra en minutos la diferencia entre el auxiliar de bancos y el
                estado de cuenta, que le tomaba horas. Lo cuenta él mismo, en {daniel.duracionTexto}:
              </p>
              <div class="prueba-video">
                <VideoFacade
                  videoId={daniel.videoId}
                  titulo={daniel.titulo}
                  poster={daniel.poster}
                  cinta={`${daniel.nombre}, ${daniel.ciudad}`}
                />
              </div>
            </figure>
          </div>
        </section>
      )}

      {/* Antes de apartar: primero quién es, luego cuánto cuesta. */}
      <section id="autor">
        <div class="container-default">
          <div class="sec-head"><h2 class="folio">QUIÉN <b>LO DA</b></h2></div>
          <div class="autor" data-reveal>
            <div class="autor-texto">
              <p>
                Soy Israel Castro, contador público con 14 años de ejercicio y
                desarrollador de software. Empecé capturando pólizas y peleándome
                con el portal del SAT, igual que tú.
              </p>
              <p>
                Cada jueves resuelvo un problema de despacho en vivo en{" "}
                <a href="/jueves">Jueves de ContadorIA</a>, y doy los módulos de
                Claude Code y de Excel en {COLABORACION?.nombre ?? "Claude para Contadores"}. Este reto
                es lo que le daría a alguien que quiere pasar de probar la IA a trabajar con ella.
              </p>
            </div>
            <img
              src="/assets/israel-saco-invita.webp"
              alt="Israel Castro invitando a pasar"
              width="760"
              height="1018"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </section>
    </div>

    <div class="mundo" data-mundo="noche">
      <section id="apartar">
        <div class="container-default">
          <div class="sec-head"><h2 class="folio">CÓMO <b>APARTAR</b> TU LUGAR</h2></div>
          <article class="compra" data-reveal>
            <div class="compra-izq">
              <p class="folio">{fechaFolio.toUpperCase()} · <b>{EMPIEZA.horario.toUpperCase()}</b></p>
              <ul class="incluye">
                {INCLUYE.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <div class="compra-der">
              <p class="precio"><b>{EMPIEZA.precioTexto}</b> <span>pago único · requiere {EMPIEZA.herramienta.nombre}, aparte</span></p>
              {urlAbierta ? (
                <a class="btn btn-primary" href={checkoutDe(abierta!, "ficha") ?? urlAbierta} rel="noopener">Apartar mi lugar</a>
              ) : (
                <div class="aviso-boton">
                  <button type="button" class="btn btn-primary" data-aviso>{textoBoton}</button>
                  <button type="button" class="aviso-nota" data-aviso>Clic aquí para apartar tu lugar</button>
                </div>
              )}
              <p class="garantia folio">// {EMPIEZA.garantia.toUpperCase()}</p>
            </div>
          </article>
        </div>
      </section>
    </div>

    <div class="mundo" data-mundo="dia">
      <section id="faq">
        <div class="container-narrow">
          <div class="sec-head"><h2 class="folio">PREGUNTAS <b>DIRECTAS</b></h2></div>
          <FaqBlock items={FAQ_EMPIEZA} />
        </div>
      </section>
    </div>
  </main>
  <Hojas />

  {/*
    "Avísame cuándo": mientras el evento de nas.com no existe, los botones de
    registro abren este cuadro, que recoge el correo en la lista `reto` de
    Sendy (doble opt-in, una lista por promesa). <dialog> nativo: foco,
    Escape y fondo salen solos. Va fuera de <main> y pide su mundo (noche)
    porque el cuadro vive en la capa superior, fuera de las hojas.
  */}
  {modoAviso && (
    <dialog class="aviso" id="aviso" data-mundo="noche" aria-labelledby="aviso-titulo">
      <form method="dialog" class="aviso-cerrar-form">
        <button class="aviso-cerrar" aria-label="Cerrar">×</button>
      </form>
      <p class="folio">{hayPorAbrir ? `CUPO DE ${EMPIEZA.cupo} · ${fechaFolio.toUpperCase()}` : "PRÓXIMA EDICIÓN"}</p>
      <h2 id="aviso-titulo">{tituloAviso}</h2>
      <p class="aviso-texto">
        {hayPorAbrir
          ? `Te escribo el día que abre, y no antes. Un solo correo. Los lugares son ${EMPIEZA.cupo} y se ocupan en orden de llegada.`
          : "Te escribo cuando se abra la siguiente fecha, y no antes. Un solo correo."}
      </p>
      <NewsletterForm
        boton="Avísame"
        lista="reto"
        exito="Listo. Confirma tu correo y te aviso en cuanto abra el registro."
        nota="Sin spam. Te das de baja con un clic."
      />
    </dialog>
  )}
</BaseLayout>

<script>
  import { PIXEL_EMPIEZA } from "../lib/empieza";
  import { medir, medirMeta } from "../lib/medir";
  import { conOrigenDeVisita, esCheckoutNas } from "../lib/origen";

  // Pixel de Meta: quien llega a la página del taller. Sin datos personales.
  medirMeta("ViewContent", PIXEL_EMPIEZA);

  const aCheckout = (a: HTMLAnchorElement): boolean => {
    try {
      return esCheckoutNas(new URL(a.href));
    } catch {
      return false;
    }
  };

  /* Los botones al checkout se llevan el fbclid y los utm_* con los que
     llegó la visita (ver conOrigenDeVisita). Se reescribe el href al cargar y
     no en el clic, para que también sirva con "abrir en pestaña nueva". */
  const visita = new URLSearchParams(location.search);
  for (const a of document.querySelectorAll<HTMLAnchorElement>("a[href]")) {
    if (aCheckout(a)) a.href = conOrigenDeVisita(a.href, visita);
  }

  /* AddToCart, y no InitiateCheckout (2026-10-20): nas.com dispara su propio
     InitiateCheckout, sin valor, al abrir el checkout, y con dos eventos
     iguales cada visita se contaba dos veces sin forma de deduplicarlas.
     InitiateCheckout queda solo para nas.com; este clic es la intención previa.
     Uno por clic y antes de irse. Al navegar, el navegador
     puede cancelar la petición del pixel a medio camino, así que el clic se
     detiene 300 ms y luego se navega. El candado se traga el segundo clic de
     un doble clic, y se suelta antes de navegar para que un "atrás" (que
     restaura la página tal cual) no lo encuentre cerrado. Si el clic abre
     otra pestaña, esta página sigue viva y no hace falta esperar. Sin pixel
     (local, preview, bloqueador) el enlace funciona como siempre. */
  let saliendo = false;
  document.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement | null)?.closest?.("a");
    if (!a || !aCheckout(a)) return;
    if (saliendo) {
      e.preventDefault();
      return;
    }
    medirMeta("AddToCart", PIXEL_EMPIEZA);
    const otraPestana = e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || a.target === "_blank";
    if (!window.fbq || otraPestana) return;
    e.preventDefault();
    saliendo = true;
    const destino = a.href;
    setTimeout(() => {
      saliendo = false;
      location.assign(destino);
    }, 300);
  });

  /* La línea de tiempo (#la-semana). Cada día está "pendiente", "activo" (cruza
     una franja en medio de la ventana) o "hecho" (ya quedó arriba). Es un
     IntersectionObserver y no un escucha de scroll: nada corre por cuadro. Las
     clases las lee el CSS (nodo, tramo de línea, tarjeta, etapas y la barra);
     sin JavaScript no se pone `reto-vivo` y todo se ve completo, sin estados. */
  const dias = [...document.querySelectorAll<HTMLElement>("[data-dia]")];
  const etapas = [...document.querySelectorAll<HTMLElement>("[data-etapa]")];
  const nav = document.querySelector<HTMLElement>(".etapas");
  if (dias.length && nav) {
    document.documentElement.classList.add("reto-vivo");
    const pos: Array<"arriba" | "dentro" | "abajo"> = dias.map(() => "abajo");
    const pintar = () => {
      let hechos = 0;
      let activo = -1;
      dias.forEach((d, i) => {
        const estado = pos[i] === "dentro" ? "activo" : pos[i] === "arriba" ? "hecho" : "pendiente";
        if (d.dataset.estado !== estado) d.dataset.estado = estado;
        if (etapas[i] && etapas[i].dataset.estado !== estado) etapas[i].dataset.estado = estado;
        if (estado === "hecho") hechos++;
        if (estado === "activo") activo = i;
      });
      /* La barra avanza hasta el centro del chip activo; con todos hechos, llena. */
      const llenos = hechos + (activo >= 0 ? 0.5 : 0);
      nav.style.setProperty("--avance", String(Math.min(1, llenos / dias.length)));
      nav.style.setProperty("--avance-paso", String(hechos + (activo >= 0 ? 1 : 0)));
    };
    const io = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          const i = dias.indexOf(e.target as HTMLElement);
          if (i < 0) continue;
          pos[i] = e.isIntersecting ? "dentro" : e.boundingClientRect.top < 0 ? "arriba" : "abajo";
        }
        pintar();
      },
      { rootMargin: "-42% 0px -48% 0px" },
    );
    dias.forEach((d) => io.observe(d));
    pintar();
  }

  /* "Avísame cuándo": cualquier [data-aviso] abre el cuadro. El clic en el
     fondo (fuera de la tarjeta) lo cierra, además de Escape y la ×. */
  const aviso = document.querySelector<HTMLDialogElement>("#aviso");
  if (aviso) {
    document.addEventListener("click", (e) => {
      /* [data-aviso] son los botones de la página; el de la cabecera es un
         enlace a #apartar (la cabecera es de cada página y solo recibe un
         href), y mientras no haya checkout también abre el cuadro. */
      const t = (e.target as HTMLElement | null)?.closest?.("[data-aviso], .site-header a[href='#apartar']");
      if (!t) return;
      e.preventDefault();
      if (!aviso.open) aviso.showModal();
      medir("aviso_reto_abierto");
    });
    aviso.addEventListener("click", (e) => {
      if (e.target === aviso) aviso.close();
    });
  }

  /* La franja de etapas es fija bajo la cabecera: se mide la cabecera real
     (cambia con el ancho) y se publica como --alto-cab. */
  const cabecera = document.querySelector<HTMLElement>(".site-header");
  if (cabecera) {
    const publicarAlto = () =>
      document.documentElement.style.setProperty("--alto-cab", `${cabecera.offsetHeight}px`);
    publicarAlto();
    new ResizeObserver(publicarAlto).observe(cabecera);
  }
</script>

<style>
  section {
    padding: 3.4rem 0;
  }
  .hero {
    padding-top: 4.5rem;
