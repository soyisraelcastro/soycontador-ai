---
/**
 * El aviso de arriba de todo: el reto de 5 días tiene fecha y cuenta regresiva.
 *
 * Vive DENTRO de la cabecera (Nav.astro), como su primer renglón, así que se
 * queda pegado arriba al bajar junto con el menú. BaseLayout lo pide en todas
 * las páginas menos en /empieza (ahí sobra) y en las de captación (`desnudo`).
 *
 * Cuándo sale y cuándo no:
 * - En el build: solo si hay una edición con lugares y checkout
 *   (`edicionAbierta()`). Sin edición no se pinta nada.
 * - En el navegador: la cuenta regresiva se escribe con la fecha del día, y al
 *   terminar el primer día de la edición (`cierreDeAviso`) el aviso se
 *   esconde solo, aunque el sitio no se haya vuelto a publicar (ver
 *   lib/reto-vivo.ts, que corre desde BaseLayout).
 * - Quien lo cierra con la × no lo vuelve a ver en esa pestaña.
 *
 * Medición: el enlace lleva `data-reto` y Analytics.astro manda `clic_reto`
 * con la ubicación y la página. NO lleva utm_*: un utm en un enlace interno
 * pisa la fuente real de la visita (el anuncio, Instagram) en GA4 y en
 * lib/origen.ts. El `?desde=` solo marca la ruta en los informes de páginas.
 */
import { EMPIEZA, cierreDeAviso, edicionAbierta, isoDe } from "../lib/empieza";

const edicion = edicionAbierta();
const inicio = edicion ? isoDe(edicion) : null;
const fecha = inicio
  ? new Date(inicio).toLocaleDateString("es-MX", { day: "numeric", month: "long", timeZone: "America/Mexico_City" })
  : null;
---

{edicion && inicio && (
  <div class="aviso-reto" data-cierra={cierreDeAviso(edicion)} data-aviso-reto={edicion.inicio}>
    <a class="aviso-enlace" href="/empieza?desde=aviso" data-reto="aviso">
      <span class="aviso-punto" aria-hidden="true"></span>
      <span class="aviso-cuenta" data-faltan={inicio}>Empieza el {fecha}</span>
      <span class="aviso-texto">
        <b>Empieza aquí:</b> el reto de 5 días con Claude<span class="aviso-extra"> · {EMPIEZA.cupo} lugares</span>
      </span>
      <span class="aviso-corto">Reto de 5 días</span>
      <span class="aviso-cta">Aparta<span class="aviso-extra"> tu lugar</span> <span aria-hidden="true">→</span></span>
    </a>
    <button type="button" class="aviso-cerrar" aria-label="Cerrar el aviso">×</button>
  </div>
)}

{/* Antes de pintar: si ya lo cerró en esta pestaña, ni se asoma. */}
<script is:inline>
  try {
    var av = document.querySelector("[data-aviso-reto]");
    if (av && sessionStorage.getItem("aviso-reto-cerrado") === av.getAttribute("data-aviso-reto")) av.hidden = true;
  } catch (e) {}
</script>

<style>
  .aviso-reto {
    position: relative;
    background: var(--color-terminal-bg);
    color: var(--color-terminal-bright);
    border-bottom: 1px solid var(--color-terminal-chrome);
  }
  .aviso-enlace {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 0.9rem;
    padding: 0.6rem 3rem 0.6rem 1rem;
    color: inherit;
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.3;
    text-align: center;
  }
  .aviso-punto {
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--color-marker);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--color-marker) 60%, transparent);
    animation: aviso-late 1.8s var(--ease-f) infinite;
  }
  .aviso-cuenta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-marker);
  }
  .aviso-texto b {
    font-weight: 700;
  }
  .aviso-corto {
    display: none;
  }
  .aviso-cta {
    font-weight: 700;
    color: var(--color-terminal-bg);
    background: var(--color-marker);
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    transition: transform 0.2s var(--ease-f);
  }
  .aviso-enlace:hover .aviso-cta,
  .aviso-enlace:focus-visible .aviso-cta {
    transform: translateX(3px);
  }
  .aviso-enlace:focus-visible {
    outline: 2px solid var(--color-marker);
    outline-offset: -4px;
  }
  .aviso-cerrar {
    position: absolute;
    top: 50%;
    right: 0.5rem;
    translate: 0 -50%;
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--color-terminal-ink);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }
  .aviso-cerrar:hover,
  .aviso-cerrar:focus-visible {
    color: var(--color-terminal-bright);
    background: var(--color-terminal-chrome);
  }
  /* En el teléfono, un solo renglón: como va pegado arriba, cada renglón de
     más es pantalla que se le quita a la página. Queda la cuenta, el nombre
     corto y "Aparta →". */
  @media (max-width: 640px) {
    .aviso-enlace {
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 0.6rem;
      padding: 0.5rem 2.6rem 0.5rem 0.9rem;
      font-size: 0.8rem;
    }
    .aviso-cuenta {
      font-size: 0.7rem;
      letter-spacing: 0.05em;
    }
    .aviso-texto,
    .aviso-extra {
      display: none;
    }
    .aviso-corto {
      display: inline;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .aviso-cta {
      margin-left: auto;
      padding: 0.25rem 0.7rem;
    }
    .aviso-cerrar {
      right: 0.25rem;
    }
  }
  @keyframes aviso-late {
    70% {
      box-shadow: 0 0 0 0.45rem color-mix(in oklab, var(--color-marker) 0%, transparent);
    }
    100% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--color-marker) 0%, transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aviso-punto {
      animation: none;
    }
    .aviso-cta {
      transition: none;
    }
  }
</style>

<script>
  /* El alto del aviso, para que la portada de la home siga cabiendo en la
     primera pantalla (index.astro lo resta de su min-height). Al cerrarlo, la
     cabecera se encoge: el evento resize hace que las hojas de la home vuelvan
     a medir dónde se pegan (Hojas.astro escucha resize). */
  const aviso = document.querySelector<HTMLElement>("[data-aviso-reto]");
  const raiz = document.documentElement;
  const publicar = () => raiz.style.setProperty("--alto-aviso", `${aviso && !aviso.hidden ? aviso.offsetHeight : 0}px`);
  if (aviso) {
    publicar();
    new ResizeObserver(publicar).observe(aviso);
    aviso.querySelector(".aviso-cerrar")?.addEventListener("click", () => {
      aviso.hidden = true;
      publicar();
      dispatchEvent(new Event("resize"));
      try {
        sessionStorage.setItem("aviso-reto-cerrado", aviso.dataset.avisoReto ?? "");
      } catch {}
    });
  }
</script>
